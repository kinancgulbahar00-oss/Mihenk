# Mihenk ortam degiskenleri. Bu dosyayi .env olarak kopyalayin ve DEGERLERI DOLDURUN.
# Ornek degerler bilerek bos birakilmistir: tanimsiz veya zayif parola ile servis baslamaz.

# --- Veritabani -------------------------------------------------------------
# Yerel calistirma (SQLite):
DATABASE_URL=sqlite:///./cti_platform.db
# Docker Compose: DATABASE_URL Compose tarafindan asagidaki degerlerden uretilir.
POSTGRES_USER=cti_user
POSTGRES_DB=cti_db
# Guclu ve rastgele olmali. Uretmek icin: py -3.11 -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=

# --- Yonetici girisi ---------------------------------------------------------
# Onerilen: parolanin ozeti. Uretmek icin:  py -3.11 -m backend.hash_password
# Deger '$' icerdigi icin TEK TIRNAK icinde yazin:  ADMIN_PASSWORD_HASH='scrypt$16384$8$1$...'
ADMIN_PASSWORD_HASH=
# Alternatif (yalnizca yerel gelistirme): en az 12 karakterli, en az 8 farkli karakter ve
# iki karakter turu (harf/rakam/sembol) iceren duz metin parola.
# ADMIN_PASSWORD_HASH tanimliysa bu deger yok sayilir.
ADMIN_PASSWORD=
# Yonetici oturumunun omru (dakika)
ADMIN_SESSION_TTL_MINUTES=480
# Oturum cerezi yalnizca HTTPS uzerinden gonderilir. http://localhost disinda duz HTTP ile
# gelistirme yapiyorsaniz false yapin. Uretimde her zaman true kalmalidir.
COOKIE_SECURE=true

# --- Istek sinirlari -----------------------------------------------------------
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_SECONDS=900
# Tum istemciler icin saatlik hatali giris esigi (IP'den bagimsiz). Esik asilinca giris
# REDDEDILMEZ; her deneme LOGIN_GLOBAL_DELAY_SECONDS geciktirilir ve kayitta "ALERT admin login
# global failure threshold exceeded" uyarisi olusur (Z-03). Bu satiri izleme sisteminize baglayin.
LOGIN_GLOBAL_MAX_FAILURES=50
LOGIN_GLOBAL_DELAY_SECONDS=2
# Yonetici icin guvenilen ag araliklari (virgulle ayrilmis CIDR). Bu araliklar genel esikten
# etkilenmez. ADMIN_RESTRICT_TO_TRUSTED=true ise yonetici paneli YALNIZCA bu araliklardan kullanilir.
ADMIN_TRUSTED_NETWORKS=
ADMIN_RESTRICT_TO_TRUSTED=false
# Ikinci etken (TOTP). Uretmek icin: py -3.11 -m backend.totp_secret
# Tanimliysa giriste parola ile birlikte dogrulayici uygulamadaki 6 haneli kod istenir.
ADMIN_TOTP_SECRET=
ANALYZE_RATE_PER_MINUTE=20
# Ortak analiz yuvasi sayisi. Ayni alan adina ayni anda sinirli sayida yoklama yapilir ve sure butcesini
# asan ADRES 10 dakika yeniden yoklanmaz (Z-04, B-04); yuvalar tek bir yavas sunucuya baglanamaz.
ANALYZE_MAX_CONCURRENT=12
# Tek istemcinin ayni anda calistirabilecegi analiz sayisi
ANALYZE_MAX_CONCURRENT_PER_CLIENT=1
# Analiz hattinin tamami icin ust sure (saniye)
ANALYZE_TIMEOUT_SECONDS=45
# Istek govdesi ust siniri: arka uc (bayt) ve ters vekil (Caddy boyut bicimi)
MAX_REQUEST_BODY_BYTES=16384
MAX_REQUEST_BODY=16KB
# Istek govdesinin tamamlanmasi icin ust sure (saniye; B-03). Ters vekilde de read_body 10s tanimlidir.
REQUEST_BODY_TIMEOUT_SECONDS=10
# Bir istemcinin ayni anda islenen POST/DELETE istegi siniri; govde okunmadan uygulanir (A-07)
MAX_INFLIGHT_PER_CLIENT=6
# Sayfa yoklamasinin taklit ettigi Chrome ana surumu (A-05, E-06). Baslik degerleri gercek tarayicidan
# kaydedilip backend/data/chrome_headers.json dosyasinda tutulur; kararli surum degistiginde ikisini
# birlikte guncelleyin (test paketi kaydin bir yildan eski olmadigini denetler)
PROBE_CHROME_MAJOR=156

# --- Kayit saklama -------------------------------------------------------------
# Analiz kayitlarinin saklama suresi (gun) ve gosterge basina tutulan en fazla analiz sonucu
IOC_RETENTION_DAYS=90
MAX_RESULTS_PER_IOC=20

# --- Harici servisler -------------------------------------------------------
# Ucretsiz anahtar: VirusTotal ve AbuseIPDB
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=

# Sayfa icerigi analizi (supheli sayfa JavaScript calistirilmadan indirilir). Kapatmak icin false yapin.
PAGE_FETCH_ENABLED=true

# --- Dagitim ----------------------------------------------------------------
# Docker Compose bu dosyanin TAMAMINI arka uca verir (env_file; D-04). Arka uc acilista ikinci
# etken, guvenilen aglar ve sinirlarin fiili durumunu "security state" satiriyla kayda yazar ve
# yonetici panelinde gosterir; ayarlarinizin uygulandigini oradan dogrulayin.
#
# Analiz edilen adlarin cozumlenecegi genel DNS sunuculari (Compose). Kurumsal agda dis DNS
# kapaliysa, ic adlari COZMEYEN bir cozumleyici verin.
ANALYSIS_DNS_1=1.1.1.1
ANALYSIS_DNS_2=9.9.9.9
# Sitenin herkese acik adresi (SEO). Tanimliysa ana sayfa arama motorlarina acilir: canonical, Open Graph,
# yapilandirilmis veri, robots.txt ve sitemap.xml bu adresle uretilir. BOS birakilirsa (yerel / ic ag / deneme
# kurulumu) butun sayfalar "noindex" olur. Ornek: PUBLIC_BASE_URL=https://mihenk.example.com
PUBLIC_BASE_URL=
# Docker Compose'daki TLS vekilinin alan adi (gercek alan adinda otomatik sertifika alinir)
SITE_ADDRESS=localhost
# Vekil <-> arka uc ic agi. Arka uc vekil basliklarina yalnizca PROXY_IP adresinden guvenir.
# Yerel aglarinizla cakisiyorsa uc degeri birlikte degistirin.
APP_SUBNET=172.31.250.0/29
PROXY_IP=172.31.250.2
BACKEND_IP=172.31.250.3
# Arayuz arka uctan farkli bir kokenden sunuluyorsa, virgulle ayrilmis kokenler (joker '*' kabul edilmez)
CORS_ORIGINS=
# Swagger/ReDoc dokumantasyonu. Uretimde false kalmalidir.
ENABLE_API_DOCS=false
